{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "name"],
  "if": {"properties": {"exe_required": {"const": false}}, "required": ["exe_required"]},
  "else": {"required": ["exe"], "properties": {"exe": {"type": "string", "minLength": 1}}},
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_\\-]+$"},
    "name": {"type": "string"},
    "install_dir": {"type": "string"},
    "exe": {"type": "string"},
    "exe_required": {"type": "boolean", "default": true},
    "args": {"type": "array", "items": {"type": "string"}},
    "ports": {"type": "array", "items": {"type": "object", "required": ["proto","port"],
      "properties": {"proto": {"enum": ["tcp","udp"]}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}}},
    "prerequisites": {"type": "array", "items": {"type": "string"}},
    "config_patch": {"type": "object", "additionalProperties": {"type": "string"}},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "art": {"type": "string"}
  }
}
