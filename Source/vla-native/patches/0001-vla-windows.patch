diff --git a/osdep/VlaSharedDevice.inl b/osdep/VlaSharedDevice.inl
new file mode 100644
index 0000000..43f2470
--- /dev/null
+++ b/osdep/VlaSharedDevice.inl
@@ -0,0 +1,175 @@
+// LAN Launcher VLA modification: use an unchanged signed shared driver, binding
+// only a freshly created instance. Included in namespace ZeroTier.
+static std::string vlaSharedDriverConflict(const char *pathToInf)
+{
+    HKEY service;
+    LONG opened = RegOpenKeyExA(HKEY_LOCAL_MACHINE,"SYSTEM\\CurrentControlSet\\Services\\zttap300",0,KEY_READ,&service);
+    if (opened == ERROR_FILE_NOT_FOUND || opened == ERROR_PATH_NOT_FOUND) return std::string();
+    if (opened != ERROR_SUCCESS) return "unable to inspect the existing shared zttap300 service";
+    char image[32768] = {};
+    DWORD length = sizeof(image);
+    LONG read = RegGetValueA(service,NULL,"ImagePath",RRF_RT_REG_SZ|RRF_RT_REG_EXPAND_SZ,NULL,image,&length);
+    RegCloseKey(service);
+    if (read != ERROR_SUCCESS) return "existing shared zttap300 ImagePath is unavailable";
+    std::string existingPath(image);
+    if (existingPath.size() >= 2 && existingPath.front() == '"' && existingPath.back() == '"')
+        existingPath = existingPath.substr(1,existingPath.size()-2);
+    if (existingPath.compare(0,4,"\\??\\") == 0) existingPath.erase(0,4);
+    char windows[32768] = {};
+    UINT windowsLength = GetWindowsDirectoryA(windows,sizeof(windows));
+    if (!windowsLength || windowsLength >= sizeof(windows)) return "unable to resolve the Windows driver directory";
+    if (!strnicmp(existingPath.c_str(),"\\SystemRoot\\",12)) existingPath = std::string(windows) + existingPath.substr(11);
+    else if (!strnicmp(existingPath.c_str(),"System32\\",9)) existingPath = std::string(windows) + "\\" + existingPath;
+    if (existingPath.size() < 3 || existingPath[1] != ':' || (existingPath[2] != '\\' && existingPath[2] != '/'))
+        return "existing shared zttap300 ImagePath has an unsupported format";
+    const std::string inf(pathToInf ? pathToInf : "");
+    const std::string::size_type separator = inf.find_last_of("\\/");
+    if (separator == std::string::npos) return "invalid packaged signed-driver path";
+    std::string existingBytes,packagedBytes;
+    if (!OSUtils::readFile(existingPath.c_str(),existingBytes) || !OSUtils::readFile((inf.substr(0,separator+1)+"zttap300.sys").c_str(),packagedBytes))
+        return "unable to verify the existing shared zttap300 binary";
+    if (existingBytes.empty() || existingBytes != packagedBytes)
+        return "the shared zttap300 driver belongs to another version; VLA will not replace it";
+    return std::string();
+}
+
+std::string WindowsEthernetTap::addNewPersistentTapDevice(const char *pathToInf,const char *homePath,const char *ownershipTag,std::string &deviceInstanceId)
+{
+    Mutex::Lock lock(_systemDeviceManagementLock);
+    const std::string tag(ownershipTag ? ownershipTag : "");
+    if (!vlaValidTag(tag) || !homePath || !*homePath) return "invalid VLA device ownership context";
+    const std::string initialConflict(vlaSharedDriverConflict(pathToInf));
+    if (!initialConflict.empty()) return initialConflict;
+    const std::string ledgerDirectory(std::string(homePath) + "\\vla-devices.d");
+    const std::string ledger(vlaLedgerPath(homePath,tag));
+    if (!OSUtils::mkdir(ledgerDirectory)) return "unable to create VLA ownership ledger directory";
+
+    HMODULE setup = GetModuleHandleA("setupapi.dll");
+    auto getParams = reinterpret_cast<decltype(&SetupDiGetDeviceInstallParamsA)>(GetProcAddress(setup,"SetupDiGetDeviceInstallParamsA"));
+    auto setParams = reinterpret_cast<decltype(&SetupDiSetDeviceInstallParamsA)>(GetProcAddress(setup,"SetupDiSetDeviceInstallParamsA"));
+    auto buildDrivers = reinterpret_cast<decltype(&SetupDiBuildDriverInfoList)>(GetProcAddress(setup,"SetupDiBuildDriverInfoList"));
+    auto enumDrivers = reinterpret_cast<decltype(&SetupDiEnumDriverInfoA)>(GetProcAddress(setup,"SetupDiEnumDriverInfoA"));
+    auto selectDriver = reinterpret_cast<decltype(&SetupDiSetSelectedDriverA)>(GetProcAddress(setup,"SetupDiSetSelectedDriverA"));
+    auto destroyDrivers = reinterpret_cast<decltype(&SetupDiDestroyDriverInfoList)>(GetProcAddress(setup,"SetupDiDestroyDriverInfoList"));
+    auto openKey = reinterpret_cast<decltype(&SetupDiOpenDevRegKey)>(GetProcAddress(setup,"SetupDiOpenDevRegKey"));
+    if (!getParams || !setParams || !buildDrivers || !enumDrivers || !selectDriver || !destroyDrivers || !openKey)
+        return "required per-device Windows SetupAPI functions are unavailable";
+
+    GUID classGuid;
+    char className[1024] = {};
+    if (!WINENV.SetupDiGetINFClassA(pathToInf,&classGuid,className,sizeof(className),NULL)) return "unable to read original signed driver INF";
+    HDEVINFO devices = WINENV.SetupDiCreateDeviceInfoList(&classGuid,NULL);
+    if (devices == INVALID_HANDLE_VALUE) return "unable to create VLA device information set";
+    SP_DEVINFO_DATA device = {};
+    device.cbSize = sizeof(device);
+    bool registered = false, haveDrivers = false, ledgerWritten = false;
+    std::string createdInstance;
+    auto fail = [&](const char *message) -> std::string {
+        // This information element was created by this invocation. Never search
+        // for another matching device, or uninstall the shared package/service.
+        bool removed = !registered;
+        if (registered) {
+            SP_REMOVEDEVICE_PARAMS remove = {};
+            remove.ClassInstallHeader.cbSize = sizeof(SP_CLASSINSTALL_HEADER);
+            remove.ClassInstallHeader.InstallFunction = DIF_REMOVE;
+            remove.Scope = DI_REMOVEDEVICE_GLOBAL;
+            if (WINENV.SetupDiSetClassInstallParamsA(devices,&device,&remove.ClassInstallHeader,sizeof(remove)))
+                removed = WINENV.SetupDiCallClassInstaller(DIF_REMOVE,devices,&device) != FALSE;
+        }
+        if (haveDrivers) destroyDrivers(devices,&device,SPDIT_COMPATDRIVER);
+        WINENV.SetupDiDestroyDeviceInfoList(devices);
+        if (ledgerWritten && removed && vlaLedgerMatches(homePath,tag,createdInstance)) OSUtils::rm(ledger.c_str());
+        return std::string(message) + (removed ? "" : ("; VLA-created instance pending cleanup: " + createdInstance));
+    };
+    if (!WINENV.SetupDiCreateDeviceInfoA(devices,className,&classGuid,NULL,NULL,DICD_GENERATE_ID,&device)) return fail("unable to create a new VLA device element");
+    const char hardwareId[] = "zttap300\0"; // REG_MULTI_SZ, including two NULs
+    if (!WINENV.SetupDiSetDeviceRegistryPropertyA(devices,&device,SPDRP_HARDWAREID,reinterpret_cast<const BYTE *>(hardwareId),sizeof(hardwareId))) return fail("unable to set VLA device hardware identity");
+    if (!WINENV.SetupDiCallClassInstaller(DIF_REGISTERDEVICE,devices,&device)) return fail("unable to register the new VLA device instance");
+    registered = true;
+    char instance[1024] = {};
+    if (!WINENV.SetupDiGetDeviceInstanceIdA(devices,&device,instance,sizeof(instance),NULL)) return fail("new VLA device has no exact instance ID");
+    createdInstance = instance;
+    if (!OSUtils::writeFile(ledger.c_str(),createdInstance)) return fail("unable to persist the exact VLA-created device ID");
+    ledgerWritten = true;
+
+    SP_DEVINSTALL_PARAMS_A params = {};
+    params.cbSize = sizeof(params);
+    if (!getParams(devices,&device,&params)) return fail("unable to read VLA device install parameters");
+    if (strlen(pathToInf) >= sizeof(params.DriverPath)) return fail("signed driver INF path exceeds SetupAPI path limit");
+    strcpy_s(params.DriverPath,pathToInf);
+    params.Flags |= DI_ENUMSINGLEINF | DI_QUIETINSTALL;
+    params.FlagsEx |= DI_FLAGSEX_ALLOWEXCLUDEDDRVS;
+    if (!setParams(devices,&device,&params) || !buildDrivers(devices,&device,SPDIT_COMPATDRIVER)) return fail("unable to build an exact VLA-instance driver list");
+    haveDrivers = true;
+    SP_DRVINFO_DATA_A driver = {};
+    driver.cbSize = sizeof(driver);
+    if (!enumDrivers(devices,&device,SPDIT_COMPATDRIVER,0,&driver) || stricmp(driver.ProviderName,"ZeroTier")) return fail("expected original signed ZeroTier driver was not found");
+    if (!selectDriver(devices,&device,&driver)) return fail("unable to select the original signed driver for the new VLA instance");
+    const std::string finalConflict(vlaSharedDriverConflict(pathToInf));
+    if (!finalConflict.empty()) return fail(finalConflict.c_str());
+    // Run the complete per-device installation sequence, including network
+    // finish-install processing, rather than only its DIF_INSTALLDEVICE step.
+    HMODULE newdev = LoadLibraryExA("newdev.dll",NULL,LOAD_LIBRARY_SEARCH_SYSTEM32);
+    // DiInstallDevice is Unicode-only despite the encoding-neutral SDK typedef.
+    typedef BOOL (WINAPI *InstallDeviceW)(HWND,HDEVINFO,PSP_DEVINFO_DATA,PSP_DRVINFO_DATA_W,DWORD,PBOOL);
+    auto installDevice = newdev ? reinterpret_cast<InstallDeviceW>(GetProcAddress(newdev,"DiInstallDevice")) : NULL;
+    auto enumDriversW = reinterpret_cast<decltype(&SetupDiEnumDriverInfoW)>(GetProcAddress(setup,"SetupDiEnumDriverInfoW"));
+    if (!installDevice || !enumDriversW) {
+        if (newdev) FreeLibrary(newdev);
+        return fail("Windows per-device driver installation API is unavailable");
+    }
+    SP_DRVINFO_DATA_W installDriver = {};
+    installDriver.cbSize = sizeof(installDriver);
+    if (!enumDriversW(devices,&device,SPDIT_COMPATDRIVER,0,&installDriver) || _wcsicmp(installDriver.ProviderName,L"ZeroTier")) {
+        FreeLibrary(newdev);
